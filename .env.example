# LOCAL: pnpm setup generates .env.local with a unique private setup code.
DATABASE_URL=file:./data/pharmacie.db
APP_ORIGIN=http://localhost:3000
SETUP_TOKEN=REPLACE_WITH_64_RANDOM_HEXADECIMAL_CHARACTERS

# NETLIFY (server-only variables; use a durable remote libSQL database):
# DATABASE_URL=libsql://YOUR-DATABASE.turso.io
# DATABASE_AUTH_TOKEN=YOUR_PRIVATE_DATABASE_TOKEN
# APP_ORIGIN=https://YOUR-PROJECT.netlify.app
# SETUP_TOKEN=YOUR_PRIVATE_RANDOM_INSTALLATION_CODE
# Never use NEXT_PUBLIC_ for any secret.
