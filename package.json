{
  "name": "pharmacie-ijjai-gestion",
  "version": "11.0.1",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "dev": "node scripts/launch.mjs dev",
    "build": "next build",
    "start": "node scripts/launch.mjs start",
    "typecheck": "tsc --noEmit",
    "setup": "node scripts/setup.mjs",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:backup": "node --env-file-if-exists=.env.local scripts/backup.mjs",
    "account:recover": "node --env-file-if-exists=.env.local scripts/recover-owner.mjs",
    "test": "node scripts/test-v9.mjs",
    "test:auth": "node scripts/test-auth.mjs",
    "test:http": "node scripts/test-http.mjs",
    "test:ingredients": "node --experimental-strip-types --test scripts/test-ingredients.mjs",
    "test:purchase-product": "node --experimental-strip-types --test scripts/test-purchase-product.mjs",
    "check": "npm run typecheck && npm run test:ingredients && npm run test:purchase-product && npm run test && npm run test:auth",
    "db:restore": "node scripts/restore-backup.mjs",
    "doctor": "node scripts/doctor.mjs",
    "build:netlify": "node scripts/doctor.mjs --netlify && next build",
    "test:startup": "node scripts/test-startup.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@libsql/client": "0.18.0",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
